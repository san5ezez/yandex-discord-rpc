{
  "manifest_version": 3,
  "name": "Yandex Music Discord Rich Presence",
  "version": "1.0.1",
  "description": "Показывает текущий трек из Яндекс.Музыки в Discord Rich Presence.",
  "minimum_chrome_version": "116",
  "permissions": [
    "scripting",
    "activeTab",
    "tabs",
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://music.yandex.ru/*",
    "https://music.yandex.kz/*",
    "https://music.yandex.by/*",
    "https://music.yandex.com/*",
    "https://music.yandex.uz/*",
    "ws://127.0.0.1:8765/*",
    "ws://localhost:8765/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' ws://127.0.0.1:8765 ws://localhost:8765"
  },
  "content_scripts": [
    {
      "matches": [
        "https://music.yandex.ru/*",
        "https://music.yandex.kz/*",
        "https://music.yandex.by/*",
        "https://music.yandex.com/*",
        "https://music.yandex.uz/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Yandex Music Discord RPC"
  }
}
